                  "const response = pm.response.json();\r",
                  "\r",
                  "console.log('teste')\r",
                  "\r",
                  "// Nome da propriedade onde o token está (AJUSTE CONFORME SUA API)\r",
                  "const tokenPropertyName = 'token'; \r",
                  "\r",
                  "if (response && response[tokenPropertyName]) {\r",
                  "    const token = response[tokenPropertyName];\r",
                  "    \r",
                  "    // **SALVA O TOKEN NA VARIÁVEL GLOBAL**\r",
                  "    // Variáveis globais são ideais para tokens, pois funcionam em todas as coleções.\r",
                  "    pm.globals.set(\"auth_token\", token);\r",
                  "    \r",
                  "    // Opcional: Para verificar se deu certo\r",
                  "    console.log(\"Token salvo com sucesso:\", token);\r",
                  "\r",
                  "    // Opcional: Se sua API também retorna o tempo de expiração (exp), salve-o.\r",
                  "    // Exemplo: pm.globals.set(\"token_expiry_time\", Date.now() + (response.expires_in * 1000));\r",
                  "    \r",
                  "} else {\r",
                  "    // Falha no login ou formato de resposta inesperado\r",
                  "    console.log(\"Falha ao encontrar o token na resposta.\");\r",
                  "}"
